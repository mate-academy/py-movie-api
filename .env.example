# Django settings
SECRET_KEY=your_secret_key_here
DEBUG=True

# Database (локально SQLite або Postgres на проді)
DATABASE_URL=postgresql://user:password@localhost:5432/db_name

# Allowed hosts
ALLOWED_HOSTS=127.0.0.1,localhost

# Static & media (для продакшн конфігурації)
STATIC_URL=/static/
MEDIA_URL=/media/
