[flake8]
# Максимальна довжина рядка (стандарт для Black)
max-line-length = 88

# Папки, які Flake8 повинен ігнорувати (наприклад, міграції та віртуальне середовище)
exclude =
    .git,
    __pycache__,
    venv,
    migrations,
    manage.py

# Ігнорувати деякі специфічні правила (наприклад, конфлікти з Black)
extend-ignore = E203